{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faith-on-the-frontlines",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1-faith-frontlines",
      "database_id": "864cde68-9659-4ceb-85ff-6aec2a857253"
    }
  ],
  "routes": [
    { "pattern": "faithonthefrontlines.org", "custom_domain": true },
    { "pattern": "www.faithonthefrontlines.org", "custom_domain": true }
  ]
}
